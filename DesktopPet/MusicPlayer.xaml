<Window x:Class="DesktopPet.MusicPlayer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="音乐播放器"
        ui:WindowHelper.UseModernWindowStyle="True"
        Width="800" Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinWidth="640" MinHeight="420">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />   <!-- 左：歌单 -->
            <ColumnDefinition Width="*" />     <!-- 右：播放区 -->
        </Grid.ColumnDefinitions>

        <!-- ================= 左：歌单 ================= -->
        <Border Grid.Column="0"
                BorderThickness="0,0,1,0"
                BorderBrush="#22000000"
                Background="#0A000000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <Grid Grid.Row="0" Margin="12,14,12,10" ClipToBounds="True">
                    <TextBlock Text="播放列表"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="AddButton"
                                Content="+"
                                Width="28" Height="28"
                                FontSize="16"
                                ToolTip="添加歌曲"
                                Margin="0,0,6,0" />
                        <Button x:Name="ClearButton"
                                Content="🗑"
                                Width="28" Height="28"
                                FontSize="13"
                                ToolTip="清空列表" />
                    </StackPanel>
                </Grid>

                <!-- 歌曲列表 -->

                <TreeView x:Name="AlbumTree"
                          Grid.Row="1"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          >
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Songs}">

                            <!-- 专辑这一行长什么样 -->
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 封面 -->
                                <Border Grid.Column="0"
                                        Width="48" Height="48"
                                        CornerRadius="6"
                                        Background="#22000000"
                                        Margin="0,0,10,0">
                                    <Grid>
                                        <Image Source="{Binding Cover}"
                                               Stretch="UniformToFill" />
                                        <!-- 没有封面时的占位符 -->
                                        <TextBlock Text="♪"
                                                   FontSize="20"
                                                   Foreground="#66FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- 专辑名 -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11"
                                               Foreground="#888888"
                                               Margin="0,2,0,0">
                                        <Run Text="{Binding Songs.Count, Mode=OneWay}" />
                                        <Run Text=" 首" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- 子项（歌曲）的模板 -->
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3" MouseLeftButtonDown="Songs_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Duration,StringFormat='{}{0:m\\:ss}'}"
                                                   FontSize="11"
                                                   Foreground="#888888"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>

                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!-- ================= 右：播放区 ================= -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />      <!-- 封面 -->
                <RowDefinition Height="Auto" />   <!-- 歌名 -->
                <RowDefinition Height="Auto" />   <!-- 进度条 -->
                <RowDefinition Height="Auto" />   <!-- 时间 -->
                <RowDefinition Height="Auto" />   <!-- 控制 -->
            </Grid.RowDefinitions>

            <!-- 封面 -->
            <Border Grid.Row="0"
                    CornerRadius="12"
                    Background="#22000000"
                    Margin="0,0,0,18">
                <Grid>
                    <Image x:Name="CoverImage"
                           Stretch="UniformToFill"
                           Margin="1" />
                    <TextBlock x:Name="CoverPlaceholder"
                               Text="♪"
                               FontSize="72"
                               Foreground="#66FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 歌名 + 歌手 -->
            <StackPanel Grid.Row="1" Margin="4,0,4,14">
                <TextBlock x:Name="TitleText"
                           Text="未播放"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText"
                           Text="—"
                           FontSize="12"
                           Foreground="#888888"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- 进度条 -->
            <Slider Grid.Row="2"
                    x:Name="PositionSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    Margin="4,0,4,4" />

            <!-- 时间 -->
            <Grid Grid.Row="3" Margin="6,0,6,14">
                <TextBlock x:Name="CurrentTimeText"
                           Text="0:00"
                           FontSize="11"
                           Foreground="#888888"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="TotalTimeText"
                           Text="0:00"
                           FontSize="11"
                           Foreground="#888888"
                           HorizontalAlignment="Right" />
            </Grid>

            <!-- 控制区 -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="ModeButton"
                        Content="🔁"
                        Width="36" Height="36"
                        FontSize="16"
                        ToolTip="顺序播放" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button x:Name="PrevButton"
                            Content="⏮"
                            Width="44" Height="44"
                            FontSize="18"
                            Margin="0,0,8,0" />
                    <Button x:Name="PlayPauseButton"
                            Content="▶"
                            Width="56" Height="56"
                            FontSize="22"
                            Margin="0,0,8,0"
                            Click="PlayButton_Click" />
                    <Button x:Name="NextButton"
                            Content="⏭"
                            Width="44" Height="44"
                            FontSize="18" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="🔊"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Slider x:Name="VolumeSlider"
                            Width="80"
                            Minimum="0"
                            Maximum="1"
                            Value="0.7"
                            VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>