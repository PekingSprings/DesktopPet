<Window x:Class="DesktopPet.SettingMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:DesktopPet"
        mc:Ignorable="d"
        Title="SettingMenu" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>      <!-- 主体 -->
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                BorderBrush="#22000000"
                Padding="16,12">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <!-- logo -->
                <Image Source="/icon.ico"
                       Width="24" Height="24"
                       Margin="0,0,10,0"/>

                <!-- 文字 -->
                <TextBlock Text="设置"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左边分类列表 -->
            <ListBox x:Name="CategoryList"
                     Grid.Column="0"
                     BorderThickness="0,0,1,0"
                     Background="#0A000000"
                     >
                <ListBoxItem Content="常规" Padding="12,10"/>
                <ListBoxItem Content="外观" Padding="12,10"/>
                <ListBoxItem Content="气泡" Padding="12,10"/>
                <ListBoxItem Content="音乐" Padding="12,10"/>
                <ListBoxItem Content="关于" Padding="12,10"/>
            </ListBox>

            <!-- 右边内容区 -->
            <ContentControl Grid.Column="1"/>
        </Grid>
    </Grid>
</Window>
